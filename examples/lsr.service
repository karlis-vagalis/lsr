# Hand-edited template. Prefer `lsr service install [--user|--system] --config=...`,
# which generates this from the resolved bun + entry paths. `--user` (default)
# installs to ~/.config/systemd/user/lsr.service; `--system` to /etc/systemd/system.
[Unit]
Description=lsr local semantic search daemon (EmbeddingGemma 2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# only for --system (user units run as you already)
# User=YOUR_USER
Environment=LSR_CONFIG=/absolute/path/to/lsr.config.yaml
ExecStart=/usr/local/bin/bun /absolute/path/to/lsr/src/cli.ts serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target   # --user units use default.target
