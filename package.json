{
  "name": "@karlis-vagalis/lsr",
  "version": "0.1.0",
  "description": "Local semantic search over plugin sources (files, Papra, email) with EmbeddingGemma 2 — a `lsr` CLI + localhost HTTP daemon.",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "lsr": "./src/cli.ts"
  },
  "files": [
    "src",
    "plugins",
    "examples",
    "lsr.config.yaml.example",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlis-vagalis/lsr.git"
  },
  "keywords": [
    "semantic-search",
    "embedding",
    "embeddings",
    "rag",
    "embeddings-gemma",
    "local",
    "sqlite",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "serve": "bun run src/cli.ts serve",
    "reindex": "bun run src/cli.ts reindex",
    "search": "bun run src/cli.ts search",
    "status": "bun run src/cli.ts status",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src plugins",
    "lint:fix": "biome check --write src plugins",
    "format": "biome format --write src plugins"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "citty": "^0.2.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest"
  }
}
